# Artefatos do Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Imagens de disco — nunca versionar arquivos de vários GB
*.iso
*.iso.part
*.wim
*.esd
*.swm

# Registros de auditoria: podem conter caminhos locais do usuário.
# Não contêm senhas (ver SECURITY.md), mas não pertencem ao repositório.
*.log
audit.log

# Documentação interna — NÃO deve ir para o repositório público.
# O guia de CI/CD contém instruções de configuração do repositório (proteção
# de branch, varredura de segredos). O arquivo continua no computador local
# para consulta; apenas não é publicado.
.github/README-CICD.md

# Caches das ferramentas de análise da esteira de CI
.ruff_cache/
.semgrep_logs/
.mypy_cache/
bandit-relatorio.json
semgrep.sarif

# Sistema operacional / editores
.DS_Store
.idea/
.vscode/
